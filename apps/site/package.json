{
  "name": "@paprika/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Landing page and docs published to GitHub Pages (paprika.js.org), built with Astro as a static site.",
  "scripts": {
    "dev": "astro dev",
    "site:build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "site:draw": "node scripts/draw-landing.mjs",
    "site:draw-docs": "node scripts/draw-docs.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "pagefind": "1.6.0"
  }
}
