{
  "name": "@paprika/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Landing page and docs (Astro, static) published to GitHub Pages (paprika.js.org).",
  "scripts": {
    "dev": "astro dev",
    "site:build": "astro build && pagefind --site dist",
    "site:preview": "astro preview",
    "site:draw": "node scripts/draw-landing.mjs",
    "site:draw-docs": "node scripts/draw-docs.mjs"
  },
  "dependencies": {
    "@paprika/core": "workspace:*"
  },
  "devDependencies": {
    "astro": "7.4.13",
    "marked": "^18.3.0",
    "pagefind": "1.6.0",
    "shiki": "4.6.0"
  }
}
