---
import { getEntry, render } from "astro:content";
import Docs from "../layouts/Docs.astro";
import { COPY } from "../i18n.ts";
import { PAGES, REPO, docHref, groupOf, type Lang } from "../docs.ts";

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const c = COPY[lang];
const i = PAGES.findIndex((p) => p.slug === slug);
const page = PAGES[i]!;
const file = page[lang].file;
const entry = await getEntry("docs", file);
if (!entry) throw new Error(`docs: ${file} is not in the collection`);
const { Content, headings } = await render(entry);
const h1 = headings.find((h) => h.depth === 1)?.text ?? page[lang].label;
const prev = PAGES[i - 1];
const next = PAGES[i + 1];
---

<Docs lang={lang} slug={slug} title={`${h1} · ${c.docs.title}`} toc={headings}>
  <p class="eyebrow">{groupOf(slug)[lang]}</p>
  <article class="prose" data-pagefind-body>
    <Content />
  </article>
  <nav class="page-nav" aria-label={`${c.docs.previous} / ${c.docs.next}`}>
    {
      prev && (
        <a class="prev" href={docHref(lang, prev.slug)} rel="prev">
          <small>{c.docs.previous}</small>
          <span>{prev[lang].label}</span>
        </a>
      )
    }
    {
      next && (
        <a class="next" href={docHref(lang, next.slug)} rel="next">
          <small>{c.docs.next}</small>
          <span>{next[lang].label}</span>
        </a>
      )
    }
  </nav>
  <p class="edit"><a href={`${REPO}/edit/main/${file}`} rel="noopener">{c.docs.edit}</a></p>
</Docs>
