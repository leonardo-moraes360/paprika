---
// The hero art: a Paprika window where an agent selects a button on a drawn sign-up screen.
import { COPY } from "../i18n.ts";
import type { Lang } from "../docs.ts";

interface Props {
  lang: Lang;
}
const w = COPY[Astro.props.lang].window;
const LAYERS: [number, number, boolean][] = [
  [58, 0, false],
  [46, 10, false],
  [40, 10, false],
  [50, 10, false],
  [36, 10, true],
  [52, 0, false],
];
---

<figure class="window" role="img" aria-label={w.label}>
  <div class="bar">
    <span class="lights"><span class="dot" style="--color:var(--red);--size:10px"></span><span class="dot" style="--color:var(--yellow);--size:10px"></span><span class="dot" style="--color:var(--green);--size:10px"></span></span>
    <span class="file">{w.file}</span>
  </div>
  <div class="body">
    <div class="layers">
      {
        LAYERS.map(([width, indent, active]) => (
          <span class:list={["layer", { active }]} style={`padding-left:${8 + indent}px`}>
            <span class="icon" />
            <span class="name" style={`width:${width}px`} />
          </span>
        ))
      }
    </div>
    <div class="stage">
      <div class="screen">
        <div class="content">
          <span class="app"><span class="dot" style="--color:var(--red);--size:12px"></span>{w.brand}</span>
          <span class="screen-title">{w.screen}</span>
          {
            w.fields.map((f) => (
              <span class="field">
                {f}
                <span class="input" />
              </span>
            ))
          }
        </div>
        <span class="button">{w.button}</span>
        <span class="selection"></span>
        <span class="handle" style="left:10px;top:160px"></span>
        <span class="handle" style="left:172px;top:160px"></span>
        <span class="handle" style="left:10px;top:202px"></span>
        <span class="handle" style="left:172px;top:202px"></span>
      </div>
      <div class="cursor">
        <svg width="13" height="19.4" viewBox="0 0 13 19.4"><path d="M0 0 L0 17 L4.6 12.6 L7.6 19.4 L10.4 18.2 L7.4 11.6 L13 11.6 Z" fill="var(--yellow)" stroke="var(--bg)" stroke-width="1.2"></path></svg>
        <span class="agent">{w.agent}</span>
      </div>
    </div>
  </div>
</figure>

<style>
  .window {
    width: 520px;
    flex: none;
    overflow: hidden;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.45),
      0 0 120px rgba(238, 74, 53, 0.12);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .file {
    font-size: 11px;
    color: var(--muted);
  }
  .body {
    display: flex;
    height: 320px;
  }
  .layers {
    width: 110px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 6px;
    border-right: 1px solid var(--line);
  }
  .layer {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
  }
  .layer.active {
    background: var(--select-soft);
    border-radius: 5px;
  }
  .icon {
    width: 7px;
    height: 7px;
    border-radius: 1.5px;
    background: var(--line-strong);
  }
  .name {
    height: 6px;
    border-radius: 3px;
    background: var(--line-strong);
  }
  .active .icon {
    background: var(--select);
  }
  .active .name {
    background: var(--ink);
  }
  .stage {
    position: relative;
    flex: 1;
    overflow: hidden;
    background: var(--canvas);
  }
  .screen {
    position: absolute;
    left: 40px;
    top: 34px;
    width: 190px;
    height: 250px;
    border-radius: 16px;
    background: var(--paper);
  }
  .content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 18px 0;
  }
  .app {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 700;
    color: var(--paper-ink);
  }
  .screen-title {
    font-size: 16px;
    font-weight: 800;
    line-height: 1.15;
    color: var(--paper-ink);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 9.5px;
    line-height: 1.2;
    color: var(--paper-muted);
  }
  .input {
    height: 24px;
    border-radius: 6px;
    background: #fff;
    border: 1px solid var(--paper-line);
  }
  .button {
    position: absolute;
    left: 18px;
    top: 168px;
    width: 154px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: var(--red-strong);
    color: var(--on-red);
    font-size: 11px;
    font-weight: 700;
  }
  .selection {
    position: absolute;
    left: 14px;
    top: 164px;
    width: 162px;
    height: 42px;
    border: 1.5px solid var(--select);
  }
  .handle {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 1.5px;
    background: var(--surface);
    border: 1.5px solid var(--select);
  }
  .cursor {
    position: absolute;
    left: 182px;
    top: 230px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .agent {
    padding: 3px 7px;
    border-radius: 6px;
    background: var(--yellow);
    color: var(--bg);
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
  }
</style>
