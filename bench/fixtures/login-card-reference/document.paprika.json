{
  "format": "paprika/1",
  "id": "bench-login-card-reference",
  "name": "Bench: login card (reference solution)",
  "tokens": {
    "paper": "#ffffff",
    "ink": "#101828",
    "muted": "#475467",
    "brand": "#1d4ed8",
    "line": "#d0d5dd"
  },
  "rootIds": ["login"],
  "nodes": {
    "login": { "id": "login", "type": "frame", "name": "login-card", "parentId": null, "x": 0, "y": 0, "width": 360, "height": 480, "fill": "$paper", "radius": 12, "clip": true, "children": ["title", "subtitle", "email-label", "email-input", "password-label", "password-input", "cta", "forgot"] },
    "title": { "id": "title", "type": "text", "name": "title", "parentId": "login", "x": 32, "y": 40, "width": 296, "height": 32, "text": "Sign in", "color": "$ink", "fontSize": 24, "fontWeight": 700 },
    "subtitle": { "id": "subtitle", "type": "text", "name": "subtitle", "parentId": "login", "x": 32, "y": 78, "width": 296, "height": 20, "text": "Use your account to continue", "color": "$muted", "fontSize": 14 },
    "email-label": { "id": "email-label", "type": "text", "name": "email-label", "parentId": "login", "x": 32, "y": 116, "width": 120, "height": 18, "text": "Email", "color": "$ink", "fontSize": 14 },
    "email-input": { "id": "email-input", "type": "rect", "name": "email-input", "parentId": "login", "x": 32, "y": 140, "width": 296, "height": 40, "fill": "$paper", "stroke": { "color": "$line", "width": 1 }, "radius": 6 },
    "password-label": { "id": "password-label", "type": "text", "name": "password-label", "parentId": "login", "x": 32, "y": 196, "width": 120, "height": 18, "text": "Password", "color": "$ink", "fontSize": 14 },
    "password-input": { "id": "password-input", "type": "rect", "name": "password-input", "parentId": "login", "x": 32, "y": 220, "width": 296, "height": 40, "fill": "$paper", "stroke": { "color": "$line", "width": 1 }, "radius": 6 },
    "cta": { "id": "cta", "type": "frame", "name": "cta", "parentId": "login", "x": 32, "y": 288, "width": 296, "height": 44, "fill": "$brand", "radius": 10, "clip": true, "children": ["cta-label"] },
    "cta-label": { "id": "cta-label", "type": "text", "name": "cta-label", "parentId": "cta", "x": 0, "y": 12, "width": 296, "height": 20, "text": "Sign in", "color": "$paper", "fontSize": 16, "fontWeight": 600, "textAlign": "center" },
    "forgot": { "id": "forgot", "type": "text", "name": "forgot", "parentId": "login", "x": 32, "y": 348, "width": 296, "height": 18, "text": "Forgot password?", "color": "$brand", "fontSize": 14 }
  }
}
