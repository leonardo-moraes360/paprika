{
  "name": "paprika",
  "private": true,
  "version": "0.1.0",
  "description": "Local design tool for AI agents with a built-in MCP server.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @paprika/server dev",
    "start": "node packages/server/dist/cli.js serve",
    "test:e2e": "pnpm --filter @paprika/server test:e2e",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm test:e2e",
    "go:build": "cd server-go && go build -buildvcs=false -o bin/paprika ./cmd/paprika",
    "go:test": "cd server-go && go vet ./... && go test ./...",
    "go:golden": "node server-go/scripts/gen-golden.mjs && node server-go/scripts/gen-contract.mjs",
    "test:parity": "pnpm --filter @paprika/server test:parity",
    "test:parity:go": "pnpm go:build && PAPRIKA_SERVER_BIN=$PWD/server-go/bin/paprika pnpm --filter @paprika/server test:parity",
    "test:e2e:go": "pnpm go:build && PAPRIKA_SERVER_BIN=$PWD/server-go/bin/paprika pnpm --filter @paprika/server test:e2e",
    "check:go": "pnpm build && pnpm go:golden && git diff --exit-code -- server-go/internal/core/testdata server-go/contract && pnpm go:test && pnpm test:parity:go && pnpm test:e2e:go"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^22.10.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leonardo-moraes360/paprika.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-tool",
    "ai-agents",
    "canvas",
    "design-tokens",
    "react",
    "typescript"
  ]
}
