{
  "name": "@paprika/server",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "paprika": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'test/e2e/**' --exclude 'test/external/**'",
    "dev": "tsx src/cli.ts serve --file ../../examples/demo.paprika.json",
    "test:e2e": "vitest run test/e2e",
    "seed": "node scripts/seed-demo.mjs",
    "test:parity": "vitest run test/external"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@paprika/core": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "optionalDependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^4.0.0"
  }
}
